# Copy this file to deploy.env and fill in your own values.
#
#   Copy-Item tools\deploy.env.example tools\deploy.env
#
# deploy.env is git-ignored. Never commit real credentials.
# Every key can also be supplied as an environment variable, which wins over
# this file.

# ---------------------------------------------------------------- SSH 目标
DEPLOY_HOST=192.168.1.100
DEPLOY_USER=youruser
DEPLOY_PASS=yourpassword
# 用密钥代替密码时填这里，并把 DEPLOY_PASS 留空
# DEPLOY_KEY=C:\Users\you\.ssh\id_ed25519
# DEPLOY_PORT=22

# ------------------------------------------------- 站点在服务器上的位置
# 宿主机目录，会被 bind mount 进容器；需可被容器内 nginx（uid 101）读取
DEPLOY_DIR=/home/youruser/tools-download
# 本项目的容器名。部署脚本只会重建这个名字的容器
DEPLOY_CONTAINER=tools-download-nginx
DEPLOY_IMAGE=nginx:alpine
# 站点对外端口
SITE_PORT=19911

# ------------------------------------------------------- EasyUpdate 服务
# 构建机访问用的地址（tools/harvest.py 抓目录、tools/devserver.py 代理）
EU_BASE=http://192.168.1.100:19910
# 容器内网访问用的地址，写进 deploy/nginx.conf 的 proxy_pass
EU_UPSTREAM=192.168.1.100:19910
# EasyUpdate 后台账号，仅用于抓取应用清单
EU_USER=admin
EU_PASS=admin

# ----------------------------------------------------------- 本地预览端口
DEV_PORT=8099
